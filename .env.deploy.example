# Copy to .env on the deployment host. Use an existing immutable GitHub Release
# tag after its GHCR image publication completes.
OBLIDOG_INTEGRATIONS_VERSION=vX.Y.Z

# The e-Kartoteka scheduler runs before Ledger's 09:30 Europe/Warsaw job.
EKARTOTEKA_CRON=0 9 * * *
OBLIDOG_SCHEDULER_TIMEZONE=Europe/Warsaw
