#!/bin/sh
set -eu

integration="${1:?usage: oblidog-scheduler INTEGRATION}"
schedule="${EKARTOTEKA_CRON:?EKARTOTEKA_CRON must be set}"
timezone="${OBLIDOG_SCHEDULER_TIMEZONE:-Europe/Warsaw}"
crontab_path="${HOME}/.${integration}-scheduler.crontab"

case "$integration" in
    *[!A-Za-z0-9_-]*)
        echo "Integration names may contain only letters, digits, hyphens, and underscores" >&2
        exit 2
        ;;
esac

case "$schedule" in
    *'
'*)
        echo "EKARTOTEKA_CRON must be a single cron expression" >&2
        exit 2
        ;;
esac

export TZ="$timezone"
printf '%s /usr/local/bin/oblidog-scheduled-run %s\n' "$schedule" "$integration" \
    > "$crontab_path"

supercronic -test "$crontab_path"
echo "scheduler_started integration=$integration schedule=$schedule timezone=$timezone"
exec supercronic "$crontab_path"
