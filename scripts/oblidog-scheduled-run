#!/bin/sh
set -eu

integration="${1:?usage: oblidog-scheduled-run INTEGRATION}"
state_dir="${HOME}/.local/state/oblidog-integrations"
lock_path="$state_dir/${integration}.lock"
mkdir -p "$state_dir"

timestamp() {
    date --iso-8601=seconds
}

exec 9>"$lock_path"
if ! flock -n 9; then
    echo "scheduled_run_skipped integration=$integration reason=already_running at=$(timestamp)"
    exit 0
fi

started_at="$(timestamp)"
started_epoch="$(date +%s)"
echo "scheduled_run_started integration=$integration scheduled_at=$started_at actual_start=$started_at"

child_pid=""
terminate() {
    if [ -n "$child_pid" ]; then
        kill -TERM "$child_pid" 2>/dev/null || true
        wait "$child_pid" || true
    fi
    finished_at="$(timestamp)"
    duration="$(( $(date +%s) - started_epoch ))"
    echo "scheduled_run_finished integration=$integration status=interrupted exit_code=143 finished_at=$finished_at duration_seconds=$duration"
    exit 143
}
trap terminate INT TERM

oblidog-integrations "$integration" &
child_pid="$!"
set +e
wait "$child_pid"
exit_code="$?"
set -e
child_pid=""

finished_at="$(timestamp)"
duration="$(( $(date +%s) - started_epoch ))"
if [ "$exit_code" -eq 0 ]; then
    status="success"
else
    status="failure"
fi
echo "scheduled_run_finished integration=$integration status=$status exit_code=$exit_code finished_at=$finished_at duration_seconds=$duration"
exit "$exit_code"
